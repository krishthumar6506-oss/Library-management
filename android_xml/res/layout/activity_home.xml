<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RentPe"
            android:textColor="@color/rentpe_navy"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Welcome home,"
            android:textColor="@color/rentpe_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hello, Alex"
                android:textColor="@color/rentpe_navy"
                android:textSize="19sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="A"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:background="@drawable/bg_primary_pill" />
        </LinearLayout>

        <EditText
            android:id="@+id/searchProperties"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_search"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="9dp"
            android:hint="Search for your dream home..."
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/rentpe_text"
            android:textColorHint="@color/rentpe_muted"
            android:textSize="12sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="34dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:gravity="center" android:text="Apartment" android:textColor="@color/white" android:textSize="11sp" android:background="@drawable/bg_primary_pill" />
                <TextView android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginStart="8dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:gravity="center" android:text="Villa" android:textColor="@color/rentpe_text" android:textSize="11sp" android:background="@drawable/bg_search" />
                <TextView android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginStart="8dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:gravity="center" android:text="Studio" android:textColor="@color/rentpe_text" android:textSize="11sp" android:background="@drawable/bg_search" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Featured Properties" android:textColor="@color/rentpe_navy" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="View all" android:textColor="@color/rentpe_blue" android:textSize="11sp" />
        </LinearLayout>

        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="190dp" android:layout_marginTop="10dp" android:scrollbars="none">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal">
                <include layout="@layout/item_property_card" />
                <include layout="@layout/item_property_card" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Nearby Properties" android:textColor="@color/rentpe_navy" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="View all" android:textColor="@color/rentpe_blue" android:textSize="11sp" />
        </LinearLayout>

        <include layout="@layout/item_nearby_property" />
        <include layout="@layout/item_nearby_property" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="18dp" android:gravity="center" android:orientation="horizontal" android:background="@drawable/bg_card">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="⌂\nHome" android:textColor="@color/rentpe_blue" android:textSize="10sp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="♙\nSaved" android:textColor="@color/rentpe_muted" android:textSize="10sp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="♡\nWishlist" android:textColor="@color/rentpe_muted" android:textSize="10sp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="☷\nProfile" android:textColor="@color/rentpe_muted" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
